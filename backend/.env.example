# Never commit a real .env file or place secrets in config.js / browser JavaScript.
OPENAI_API_KEY=replace-with-server-side-key
OPENAI_MODEL=gpt-6.2-sol

# Create an API key on data.gov.in and set the resource UUID from its PIN directory API page.
DATA_GOV_IN_API_KEY=replace-with-data-gov-in-key
DATA_GOV_IN_RESOURCE_ID=replace-with-resource-uuid

# Configure an SMTP relay that can send email from SMTP_FROM_EMAIL.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM_EMAIL=GovEase <no-reply@example.com>
SMTP_USE_SSL=false

# Generate a long random secret (at least 32 characters) for hashing OTPs.
GOVEASE_OTP_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Use persistent storage for this SQLite file on the backend host.
GOVEASE_DATABASE_PATH=./data/govease.sqlite3
GOVEASE_CORS_ORIGINS=https://lordvictor9.github.io,http://localhost:5500,http://127.0.0.1:5500

